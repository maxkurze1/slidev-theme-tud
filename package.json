{
  "name": "slidev-theme-tud",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "description": "Corporate TUD theme for SliDev",
  "keywords": [
    "slidev-theme",
    "slidev",
    "TUD",
    "Dresden University of Technology"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxkurze1/slidev-theme-tud.git"
  },
  "bugs": {
    "url": "https://github.com/maxkurze1/slidev-theme-tud/issues"
  },
  "files": [
    "assets",
    "components",
    "layouts",
    "scripts",
    "setup",
    "styles",
    "global-bottom.vue",
    "global-top.vue",
    "markdown.ts",
    "shims.d.ts",
    "uno.config.ts",
    "vite.config.ts",
    "example.mdc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "slidev build example.mdc",
    "dev": "slidev example.mdc --remote",
    "export": "slidev export example.mdc",
    "screenshot": "slidev export example.mdc --format png"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "gsap": "^3.15.0",
    "two.js": "^0.8.24"
  },
  "peerDependencies": {
    "slidev-component-progress": "*"
  },
  "peerDependenciesMeta": {
    "slidev-component-progress": {
      "optional": true
    }
  },
  "devDependencies": {
    "@slidev/cli": "^52.19.1",
    "@slidev/types": "^52.19.1",
    "slidev-component-progress": "github:maxkurze1/slidev-component-progress"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "aspectRatio": "16/9",
      "mdc": true,
      "comark": true,
      "view-transition-clicks": true,
      "canvasWidth": 1280,
      "presenter": true,
      "titleTemplate": "%s",
      "transition": "slide-fade-left | slide-fade-right",
      "favicon": "",
      "fonts": {
        "sans": "NotoSans",
        "mono": "FiraCode",
        "provider": null
      }
    }
  }
}
